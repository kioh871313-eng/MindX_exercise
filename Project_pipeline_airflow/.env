# ============================================================
# .env.example — copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
#
# This file contains NO sensitive credentials.
# All passwords and API keys are managed via the Airflow UI:
#   Admin → Connections  (AWS S3, PostgreSQL DWH, SMTP email)
#   Admin → Variables    (S3 bucket name, pipeline config)
# ============================================================

# ------------------------------------------------------------------
# Airflow UID
# On Linux/Mac: run `echo "AIRFLOW_UID=$(id -u)"` to get your value.
# On Windows with Docker Desktop: leave as 50000.
# ------------------------------------------------------------------
AIRFLOW_UID=50000

# ------------------------------------------------------------------
# Alert recipient email address.
# This is NOT sensitive (it's just an address, not a password).
# SMTP credentials go in the Airflow Connection 'smtp_default' via UI.
# Leave blank to disable email alerts.
# ------------------------------------------------------------------
ALERT_EMAIL=kioh8713@gmail.com
